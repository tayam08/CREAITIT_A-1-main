{
  "name": "interview-local-chat-v1",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "luna:server": "node scripts/run-app-server.mjs",
    "luna:proxy": "node scripts/luna-proxy.mjs",
    "luna:admin": "node scripts/luna-admin.mjs",
    "local": "npm run runtime:prepare && concurrently -k -n SITE,LUNA,BRIDGE,ADMIN -c cyan,green,yellow,magenta \"npm run dev\" \"npm run luna:server\" \"npm run luna:proxy\" \"npm run luna:admin\"",
    "local:open": "node scripts/launch-local.mjs",
    "luna:smoke": "node scripts/smoke-luna.mjs",
    "bridge": "node scripts/agent-bridge.mjs",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/agent-bridge.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@openai/codex": "^0.150.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.127.1",
    "ws": "^8.21.3"
  },
  "type": "module"
}
